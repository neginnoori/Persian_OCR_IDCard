# setup.ps1 replaces this placeholder when creating .env for the first time.
# .env is local/private. Do not commit it.
OCR_API_KEY=CHANGE_ME_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
OCR_MODEL_DIR=./models
OCR_MAX_UPLOAD_MB=15
OCR_MAX_PIXELS=25000000
# Waiting requests only, in addition to one active GPU job.
OCR_MAX_PENDING=2
OCR_REQUEST_TIMEOUT_SECONDS=180
OCR_UPLOAD_TIMEOUT_SECONDS=30
# Batch: file count, combined file bytes (MiB), and total processing deadline.
OCR_MAX_BATCH_FILES=10
OCR_MAX_BATCH_UPLOAD_MB=50
OCR_BATCH_TIMEOUT_SECONDS=600
